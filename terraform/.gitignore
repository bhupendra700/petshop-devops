# Local .terraform directories
**/.terraform/

# .tfstate files (contains sensitive infra data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive var files
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI logs
*.log

# Ignore CLI configuration files
.terraformrc
terraform.rc